# HangiBranş — Sunucu Ortam Değişkenleri (.env)
# Bu değerleri Vercel Project Settings > Environment Variables bölümüne ekleyin.

# 1. Google Gemini API (Canlı Yapay Zeka Triyaj için — Paid Tier önerilir)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase (Tüm Türkiye 81 il hastane & doktor veritabanı için — Opsiyonel, boş bırakılırsa canlı OSM yedeği çalışır)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Sadece haftalık veri güncelleme scripti için (GitHub Secrets)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here